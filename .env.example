# Legacy isolated Supabase source only; approval administration does not use it.
VITE_SUPABASE_URL=https://your-development-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-development-publishable-key

# PostgreSQL foundation only. Put this in ignored .env.db.local, never VITE_*.
# db:local:init generates a random password and writes that file for you.
CAPE_DATABASE_URL=postgresql://cape_clergy_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/cape_clergy_vault_dev

# Phase 2B restricted local runtime; db:runtime:setup writes .env.db.runtime.local.
CAPE_RUNTIME_DATABASE_URL=postgresql://cape_clergy_runtime:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/cape_clergy_vault_dev
# Use only the restricted runtime URL in the web application environment.

# Phase 3A: server-only auth. Keep real values in ignored .env.auth.local.
# Supply .env.db.runtime.local separately; the owner URL is never needed by the app.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Default captures private JSON messages under ignored .local/email (no delivery).
EMAIL_PROVIDER=development
# Only for the local Node production-build smoke test, never a remote origin:
CAPE_LOCAL_EMAIL_CAPTURE=true
# Real mail requires EMAIL_PROVIDER=resend and EMAIL_DOMAIN_VERIFIED=true.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_DOMAIN_VERIFIED=false

# Phase 3C private storage: server-only, never VITE_*. Defaults shown below.
# Production must provision a dedicated private path outside deployment/static roots.
CAPE_STORAGE_PROVIDER=local
CAPE_STORAGE_ROOT=.local/storage
# Configurable downward, hard ceiling 20 MiB; keep reverse-proxy limit aligned.
CAPE_MAX_UPLOAD_BYTES=20971520
# Only pdf is implemented; other values fail configuration validation.
CAPE_DOCUMENT_TYPES=pdf
