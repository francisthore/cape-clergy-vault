# Non-secret review template. Manager reads this root-owned 0600 file.
NODE_ENV=production
CAPE_DATABASE_MODE=production
CAPE_STORAGE_PROVIDER=local
CAPE_STORAGE_ROOT=/var/lib/cape-vault/objects
CAPE_MAX_UPLOAD_BYTES=4194304
CAPE_DOCUMENT_TYPES=pdf
BETTER_AUTH_URL=https://REPLACE_WITH_APPROVED_VAULT_HOST
CAPE_SCREENING_MAX_BYTES=4194304
CAPE_SCANNER=bouncer
BOUNCER_UPLOAD_HOST=
CAPE_WORKER_LOCK_ROOT=/run/cape-vault/scanner
NODE_OPTIONS=--max-old-space-size=96
