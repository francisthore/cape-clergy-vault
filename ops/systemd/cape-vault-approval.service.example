# REVIEW TEMPLATE ONLY (Phase 5A-2, systemd 255 / Ubuntu 24.04 compatible).
# PrivatePIDs= needs systemd >=257 and is NOT used. A real private PID namespace comes from
# ExecStart=! plus ops/libexec/cape-vault-ns-launch.example (unshare --pid --fork, fresh /proc,
# setpriv drop to the service UID with an empty capability set). `!` (not `+`) keeps every
# other sandbox option active. service-entry refuses to start unless it is PID 1, non-root,
# capability-free and no_new_privs. UNVERIFIED ON ANY HOST: see docs/phase-5a-host-acceptance-tests.md.
# No unit, account or mount is installed/enabled by this repository.
[Unit]
Description=Cape Clergy Vault approval
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
[Service]
Type=simple
User=cape-vault-approval
Group=cape-vault-approval
Slice=cape-vault.slice
WorkingDirectory=/srv/cape-vault/current
EnvironmentFile=/etc/cape-vault/approval.environment
LoadCredential=database-password:/etc/cape-vault/secrets/approval/database-password
ExecStart=!/opt/cape-vault/libexec/cape-vault-ns-launch cape-vault-approval approval
Restart=on-failure
RestartSec=30
TimeoutStopSec=210
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
# Launcher-only capabilities (all dropped by setpriv before Node; Node starts with none).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=
RestrictNamespaces=pid mnt
PrivateMounts=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/etc/cape-vault/secrets
InaccessiblePaths=-/run/credentials/cape-vault-web.service -/run/credentials/cape-vault-scanner.service -/run/credentials/cape-vault-reviewer.service -/run/credentials/cape-vault-operator.service
InaccessiblePaths=/var/lib/cape-vault/objects
RuntimeDirectory=cape-vault/approval
RuntimeDirectoryMode=0700
ReadWritePaths=/run/cape-vault/approval
MemoryHigh=160M
MemoryMax=224M
MemorySwapMax=0
CPUQuota=15%
CPUWeight=20
IOWeight=20
OOMScoreAdjust=500
TasksMax=48
LimitNOFILE=1024
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cape-vault-approval
[Install]
WantedBy=multi-user.target
